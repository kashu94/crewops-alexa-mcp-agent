# Copy to .env and adjust. The app, the CDK app and scripts/cdk.sh all read this file.
# Defaults for everything except AWS_PROFILE live in src/crewops/config.py.
# Never put access keys here: they belong in ~/.aws, set up with `aws configure --profile`.

# AWS CLI profile to deploy and run with. Required for scripts/cdk.sh; "default" is refused.
AWS_PROFILE=crewops
# The project's home region. Other regions are blocked for the project account.
AWS_REGION=ap-southeast-2

# Deployment stage. All AWS resource names are derived from it (crewops-<stage>-...).
CREWOPS_STAGE=dev

# Bedrock models (Amazon Nova). Nova Micro runs in-region; Nova 2 Lite needs the global
# profile. Any Converse model with tool calling works; change the ID here, no code change.
CREWOPS_ROUTER_MODEL_ID=amazon.nova-micro-v1:0
CREWOPS_ADVISOR_MODEL_ID=global.amazon.nova-2-lite-v1:0
CREWOPS_EXPLAINER_MODEL_ID=global.amazon.nova-2-lite-v1:0
CREWOPS_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
CREWOPS_EMBEDDING_DIMENSIONS=512

# Bedrock Guardrails (filled in once the guardrail is deployed): the guardrail stack's
# GuardrailId and GuardrailVersionNumber outputs. A published version, never DRAFT.
CREWOPS_GUARDRAIL_ID=
CREWOPS_GUARDRAIL_VERSION=

# Agent loop limits.
CREWOPS_MAX_TOOL_ITERATIONS=8
CREWOPS_RESPONSE_BUDGET_SECONDS=6.0
