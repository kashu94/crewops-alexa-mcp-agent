# Copy to .env and adjust. Every value is optional: defaults live in src/crewops/config.py.

# Deployment stage. All AWS resource names are derived from it (crewops-<stage>-...).
CREWOPS_STAGE=dev
AWS_REGION=us-east-1

# Bedrock models. Confirm the exact IDs (or inference-profile IDs) in the Bedrock console.
CREWOPS_ROUTER_MODEL_ID=anthropic.claude-haiku-4-5
CREWOPS_ADVISOR_MODEL_ID=anthropic.claude-sonnet-5-5
CREWOPS_EXPLAINER_MODEL_ID=anthropic.claude-haiku-4-5
CREWOPS_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
CREWOPS_EMBEDDING_DIMENSIONS=512

# Bedrock Guardrails (filled in once the guardrail is deployed).
CREWOPS_GUARDRAIL_ID=
CREWOPS_GUARDRAIL_VERSION=DRAFT

# Agent loop limits.
CREWOPS_MAX_TOOL_ITERATIONS=8
CREWOPS_RESPONSE_BUDGET_SECONDS=6.0
